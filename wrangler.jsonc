{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "flow-p12",
  "account_id": "0976ee0adac0062c726747d29549308e",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-03-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "flow-p12"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "flow-p12-db",
      "database_id": "40c9fcd9-ca78-47dc-88cd-d058c90cdc01"
    }
  ],
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "flow-p12-images"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "207b6efc61d44c9288226b12bd6eb3dc"
    }
  ],
  "vars": {
    "NODE_ENV": "production"
  }
}
